{
  "sourceLanguage": "en",
  "strings": {
    " (%lld held)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（保留 %lld）"
          }
        }
      }
    },
    "%lld added / %lld updated / %lld deleted": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加 %1$lld / 更新 %2$lld / 削除 %3$lld"
          }
        }
      }
    },
    "%lld deletions on hold (%lld%% of %lld managed)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@held@ on hold (%2$lld%% of %3$lld managed)"
          },
          "substitutions": {
            "held": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg deletion"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg deletions"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除 %1$lld 件を保留中（管理中 %3$lld 件の %2$lld%%）"
          }
        }
      }
    },
    "%lld hours": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld hour"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld hours"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 時間"
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Certificate expired. Run mwinit.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書が切れています。mwinit してください"
          }
        }
      }
    },
    "Delete Held Events": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を実行"
          }
        }
      }
    },
    "Delete Held Events…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を実行…"
          }
        }
      }
    },
    "Deletes %lld held events.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deletes %lld held event."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deletes %lld held events."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中の削除 %lld 件を実行します。"
          }
        }
      }
    },
    "Deletes every Business event from %@ to %@ and fetches them again from Outlook.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲内（%1$@〜%2$@）の Business の予定をすべて削除して、Outlook から取り直します。"
          }
        }
      }
    },
    "Fetch was incomplete. Sync skipped.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得が途中で切れたため同期を見送りました"
          }
        }
      }
    },
    "Last result: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の同期：%@"
          }
        }
      }
    },
    "Last sync: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終同期：%@"
          }
        }
      }
